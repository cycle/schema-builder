{
    "name": "cycle/schema-builder",
    "type": "library",
    "license": "MIT",
    "description": "Cycle ORM Schema Builder",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Anton Titov (wolfy-j)",
            "email": "wolfy-j@spiralscout.com"
        },
        {
            "name": "Aleksei Gagarin",
            "homepage": "https://github.com/roxblnfk"
        },
        {
            "name": "Pavel Butchnev",
            "homepage": "https://github.com/butschster"
        },
        {
            "name": "Maksim Smakouz (msmakouz)",
            "email": "maksim.smakouz@spiralscout.com"
        }
    ],
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/cycle"
        }
    ],
    "require": {
        "php": ">=8.2",
        "cycle/orm": "^2.18",
        "cycle/database": "^2.23",
        "yiisoft/friendly-exception": "^1.1"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9",
        "buggregator/trap": "^1.20",
        "cycle/testing": "1.x-dev",
        "llm/skills": "^1.20",
        "phpunit/phpunit": "^9.6",
        "roxblnfk/unpoly": "^1.8",
        "testo/testo": "^0.10.60"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../testing",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Cycle\\Schema\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cycle\\Schema\\Tests\\": "tests/Schema/"
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix -v --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
        "psalm": "psalm -c vendor-bin/psalm/psalm.xml",
        "psalm:baseline": "psalm -c vendor-bin/psalm/psalm.xml --set-baseline=vendor-bin/psalm/psalm-baseline.xml",
        "psalm:ci": "psalm -c vendor-bin/psalm/psalm.xml --output-format=github --shepherd --show-info=false --stats --threads=4",
        "test": "phpunit --color=always"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "llm/skills": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false,
            "target-directory": "vendor-bin"
        }
    }
}
